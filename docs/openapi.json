{
    "components": {
        "schemas": {
            "api.AnswerRequest": {
                "properties": {
                    "idempotencyKey": {
                        "description": "IdempotencyKey makes the request safe to retry. Reusing it with a different payload is\nrejected with 422; omitting it means a retry can only be rejected, not replayed.",
                        "maxLength": 255,
                        "type": "string"
                    },
                    "optionId": {
                        "description": "OptionID must be one of that question's options.",
                        "format": "uuid",
                        "type": "string"
                    },
                    "questionId": {
                        "description": "QuestionID must be the question the session currently waits on.",
                        "format": "uuid",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "api.HealthResponse": {
                "properties": {
                    "status": {
                        "enum": [
                            "ok",
                            "ready"
                        ],
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "api.OptionDTO": {
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "api.QuestionDTO": {
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "options": {
                        "items": {
                            "$ref": "#/components/schemas/api.OptionDTO"
                        },
                        "type": "array",
                        "uniqueItems": false
                    },
                    "prompt": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "api.ResultDTO": {
                "description": "Result is present for COMPLETED and HIGH_RISK, null while the flow continues.",
                "properties": {
                    "primaryDomain": {
                        "description": "PrimaryDomain is null if the safety gate fired before the flow routed into a domain.",
                        "enum": [
                            "DEPRESSION",
                            "ANXIETY",
                            "TRAUMA"
                        ],
                        "type": "string"
                    },
                    "recommendedAction": {
                        "description": "RecommendedAction distinguishes the two routes to HIGH: IMMEDIATE_SUPPORT is produced\nonly by the safety gate, PRIORITY_SPECIALIST_ASSESSMENT is the most urgent action\nreachable through scoring alone.",
                        "enum": [
                            "SELF_CARE_RESOURCES",
                            "SPECIALIST_ASSESSMENT",
                            "PRIORITY_SPECIALIST_ASSESSMENT",
                            "IMMEDIATE_SUPPORT"
                        ],
                        "type": "string"
                    },
                    "riskLevel": {
                        "enum": [
                            "LOW",
                            "MEDIUM",
                            "HIGH"
                        ],
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "api.SessionDTO": {
                "properties": {
                    "currentDomain": {
                        "description": "CurrentDomain is null until the intake answer routes the session into a domain.",
                        "enum": [
                            "DEPRESSION",
                            "ANXIETY",
                            "TRAUMA"
                        ],
                        "type": "string"
                    },
                    "currentQuestionId": {
                        "description": "CurrentQuestionID is the question the session waits on, null once it is terminal.",
                        "type": "string"
                    },
                    "highRiskDetected": {
                        "description": "HighRiskDetected is true once the safety gate has fired for this session.",
                        "type": "boolean"
                    },
                    "sessionId": {
                        "type": "string"
                    },
                    "status": {
                        "description": "Status is IN_PROGRESS while the session accepts answers. COMPLETED and HIGH_RISK are\nterminal; a further answer returns 409 session_closed.",
                        "enum": [
                            "IN_PROGRESS",
                            "COMPLETED",
                            "HIGH_RISK"
                        ],
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "api.SessionStateResponse": {
                "properties": {
                    "currentQuestion": {
                        "$ref": "#/components/schemas/api.QuestionDTO"
                    },
                    "session": {
                        "$ref": "#/components/schemas/api.SessionDTO"
                    }
                },
                "type": "object"
            },
            "api.SubmitAnswerResponse": {
                "properties": {
                    "currentQuestion": {
                        "$ref": "#/components/schemas/api.QuestionDTO"
                    },
                    "highRisk": {
                        "description": "HighRisk is true when this answer tripped the safety gate.",
                        "type": "boolean"
                    },
                    "outcome": {
                        "description": "Outcome is a machine-readable status: NEXT_QUESTION, COMPLETED, HIGH_RISK or REPLAYED.",
                        "enum": [
                            "NEXT_QUESTION",
                            "COMPLETED",
                            "HIGH_RISK",
                            "REPLAYED"
                        ],
                        "type": "string"
                    },
                    "result": {
                        "$ref": "#/components/schemas/api.ResultDTO"
                    },
                    "session": {
                        "$ref": "#/components/schemas/api.SessionDTO"
                    }
                },
                "type": "object"
            },
            "apierr.Response": {
                "properties": {
                    "code": {
                        "description": "Code is the stable machine-readable error code. Clients branch on this.",
                        "enum": [
                            "invalid_request",
                            "option_not_found",
                            "session_not_found",
                            "question_mismatch",
                            "session_closed",
                            "session_not_complete",
                            "idempotency_key_reused",
                            "request_too_large",
                            "route_not_found",
                            "method_not_allowed",
                            "db_unavailable",
                            "internal_error"
                        ],
                        "type": "string"
                    },
                    "message": {
                        "description": "Message is human-readable and not stable; do not branch on it.",
                        "type": "string"
                    },
                    "requestId": {
                        "description": "RequestID is the correlation ID, also returned in the X-Request-ID header.",
                        "type": "string"
                    }
                },
                "type": "object"
            }
        }
    },
    "info": {
        "description": "Adaptive mental-health triage. A client starts a session, submits one answer\nat a time, and receives either the next question or a final result. Because\nthe next question depends on previous answers, a client must always answer\nthe question the session reports as current rather than a fixed sequence.\n\nTwo behaviours are worth reading before integrating:\n\n**Idempotency.** POST /answers accepts an optional `idempotencyKey` in the\nrequest **body** — it is not an HTTP header. Retrying with the same key\nreplays the original response with `outcome: REPLAYED` instead of advancing\nthe flow again, and stays safe even when the retry overlaps the original.\n\n**The safety gate.** A high-risk answer closes the session immediately with\nstatus `HIGH_RISK`; no further answers are accepted. Its result recommends\n`IMMEDIATE_SUPPORT`, an action that scoring alone never produces — which is\nwhat lets a consumer tell a crisis from a merely severe score.\n\nScores, risk flags and question routing are deliberately absent from every\nresponse: they would reveal which option trips the safety gate.",
        "title": "ARAMANA Adaptive Intelligent Triage API",
        "version": "1.0.0"
    },
    "externalDocs": {
        "description": "",
        "url": ""
    },
    "paths": {
        "/health": {
            "get": {
                "description": "Answers as long as the process is serving traffic. It does not touch the\ndatabase, so it must not be used for load-balancer readiness — use /ready.",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.HealthResponse"
                                }
                            }
                        },
                        "description": "OK"
                    }
                },
                "summary": "Liveness probe",
                "tags": [
                    "Operations"
                ]
            }
        },
        "/ready": {
            "get": {
                "description": "Checks the database, since no triage request can be served without it. This\nis the probe a load balancer should use: it starts failing while the\ndatabase is unreachable, so traffic stops being routed to the instance.",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.HealthResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "db_unavailable"
                    }
                },
                "summary": "Readiness probe",
                "tags": [
                    "Operations"
                ]
            }
        },
        "/triage/sessions": {
            "post": {
                "description": "Creates a session with status IN_PROGRESS and returns the first question.\nThe request takes no body.",
                "parameters": [
                    {
                        "description": "Correlation ID; generated when omitted and echoed back in the response header",
                        "in": "header",
                        "name": "X-Request-ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.SessionStateResponse"
                                }
                            }
                        },
                        "description": "Created"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "internal_error"
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "db_unavailable"
                    }
                },
                "summary": "Start a triage session",
                "tags": [
                    "Triage"
                ]
            }
        },
        "/triage/sessions/{session_id}": {
            "get": {
                "description": "The resume path. A client that lost its place reads the question the session\nis waiting on here and continues from it. currentQuestion is null once the\nsession is terminal (COMPLETED or HIGH_RISK) — use /result for the outcome.",
                "parameters": [
                    {
                        "description": "Session ID (UUID)",
                        "in": "path",
                        "name": "session_id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Correlation ID; generated when omitted and echoed back in the response header",
                        "in": "header",
                        "name": "X-Request-ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.SessionStateResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "invalid_request — session_id is not a UUID"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "session_not_found"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "internal_error"
                    }
                },
                "summary": "Get the current session state",
                "tags": [
                    "Triage"
                ]
            }
        },
        "/triage/sessions/{session_id}/answers": {
            "post": {
                "description": "Records one answer and advances the flow. questionId must be the question the\nsession currently waits on, and optionId must belong to it.\n\nThe `outcome` field says what happened, so a client need not infer it from\nthe shape of the response: NEXT_QUESTION (currentQuestion holds the next\nquestion, result is null), COMPLETED (result holds the outcome), HIGH_RISK\n(the safety gate fired and the session is closed), or REPLAYED (the request\ncarried an already-used idempotencyKey and the original response was\nreturned unchanged).\n\nRetries: with an idempotencyKey a retry replays the original response, even\nwhen it overlaps the original request. Without one, retrying an\nalready-answered question returns 409 question_mismatch — the flow still\ncannot advance twice, but the original response is not recoverable.",
                "parameters": [
                    {
                        "description": "Session ID (UUID)",
                        "in": "path",
                        "name": "session_id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Correlation ID; generated when omitted and echoed back in the response header",
                        "in": "header",
                        "name": "X-Request-ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "object"
                                    },
                                    {
                                        "$ref": "#/components/schemas/api.AnswerRequest",
                                        "summary": "request",
                                        "description": "Answer to the current question"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "Answer to the current question",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.SubmitAnswerResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "invalid_request or option_not_found"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "session_not_found"
                    },
                    "409": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "question_mismatch (also the losing writer under concurrency) or session_closed"
                    },
                    "413": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "request_too_large — body over 16 KiB"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "idempotency_key_reused — same key, different payload"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "internal_error"
                    }
                },
                "summary": "Submit an answer",
                "tags": [
                    "Triage"
                ]
            }
        },
        "/triage/sessions/{session_id}/result": {
            "get": {
                "description": "Available once the session is terminal. A session that is still IN_PROGRESS\nyields 409 session_not_complete, which is an ordinary state rather than a\nfailure.\n\nrecommendedAction distinguishes the two ways a session reaches\nriskLevel HIGH: IMMEDIATE_SUPPORT means the user reported being in immediate\ndanger, whereas PRIORITY_SPECIALIST_ASSESSMENT means the symptom score was\nsevere while the user denied being in danger. Only the former should trigger\nan emergency workflow.",
                "parameters": [
                    {
                        "description": "Session ID (UUID)",
                        "in": "path",
                        "name": "session_id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Correlation ID; generated when omitted and echoed back in the response header",
                        "in": "header",
                        "name": "X-Request-ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.ResultDTO"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "invalid_request — session_id is not a UUID"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "session_not_found"
                    },
                    "409": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "session_not_complete — the session is still running"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/apierr.Response"
                                }
                            }
                        },
                        "description": "internal_error"
                    }
                },
                "summary": "Get the final triage result",
                "tags": [
                    "Triage"
                ]
            }
        }
    },
    "openapi": "3.1.0",
    "tags": [
        {
            "description": "Triage sessions, answers and results",
            "name": "Triage"
        },
        {
            "description": "Liveness and readiness probes",
            "name": "Operations"
        }
    ],
    "servers": [
        {
            "description": "Local development",
            "url": "http://localhost:8080"
        }
    ]
}